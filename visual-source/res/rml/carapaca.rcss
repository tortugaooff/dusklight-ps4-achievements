window.carapaca-window {
    width: 92%;
    height: 88%;
    max-width: 760dp;
    max-height: 590dp;
    border-width: 2dp;
    border-color: #bc9e64;
    background-color: #221e1b;
    decorator: linear-gradient(145deg, #302821 0%, #231f1c 32%, #191716 100%);
    box-shadow: #100e0d 0 0 18dp 3dp;
}

window.carapaca-window content {
    flex-direction: column;
    padding: 24dp;
    overflow: hidden auto;
}

.carapaca-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: bold;
    color: #f5ddb2;
    margin: 0 30dp 8dp 0;
    padding-bottom: 6dp;
    border-bottom-width: 1dp;
    border-bottom-color: #8c7047;
}

.carapaca-progress {
    display: block;
    margin-bottom: 12dp;
    color: #e4c894;
}

.carapaca-progress-bar {
    display: block;
    flex: 0 0 8dp;
    width: 100%;
    margin-bottom: 8dp;
    background-color: #140f0c;
    border-width: 1dp;
    border-color: #695438;
}

.carapaca-progress-bar fill {
    background-color: #b39762;
    decorator: vertical-gradient(#e2ca8e #8d693b);
}

.carapaca-window achievement-row {
    flex: 0 0 auto;
    width: 100%;
}

.carapaca-window achievement-name {
    min-width: 0;
    margin-right: 8dp;
}

.carapaca-window status-badge {
    flex-shrink: 0;
}

.carapaca-filter {
    color: #e4c894;
    margin: 4dp 0 8dp;
    padding: 7dp 0;
    border-bottom-width: 1dp;
    border-bottom-color: #6c573b;
}

.carapaca-window achievement-row.carapaca-selected {
    background-color: #3e3225;
    border-left-width: 2dp;
    border-left-color: #ceb47d;
    decorator: linear-gradient(90deg, #493a29 0%, #342b23 65%, #29231e 100%);
}

.carapaca-rarity {
    display: flex;
    align-items: center;
    gap: 6dp;
    margin: 0 0 4dp;
}

.carapaca-illustration {
    width: 58dp;
    height: 58dp;
    flex-shrink: 0;
    margin-right: 12dp;
    border-width: 1dp;
    border-color: #8f7349;
}

.carapaca-rupee {
    width: 18dp;
    height: 18dp;
}

@media (max-width: 600dp) {
    window.carapaca-window content {
        padding: 16dp;
    }
}
